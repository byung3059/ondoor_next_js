# Vercel 프로젝트 → Settings → Environment Variables 에 넣는 값 (로컬은 이 파일을 .env.local로 복사해서 사용)

# 상담 폼 서명 키 — 아무도 모르는 긴 임의의 문자열
CONTACT_SECRET=

# 관리자 로그인 비밀번호 (/admin) — 로컬에서 비워 두면 기본값 ondoor-admin
ADMIN_PASSWORD=

# DB — Vercel Storage에서 Neon을 연결하면 자동으로 들어감 (로컬에서 비워 두면 data/pglite 내장 DB 사용)
DATABASE_URL=

# 매일 오래된 문의 자동 삭제(Vercel Cron) 확인용 — 긴 임의의 문자열
CRON_SECRET=

# (선택) 새 문의 알림 메일 — Resend API 키 · 받을 주소(쉼표로 여러 개) · 보내는 주소(Resend에서 인증한 도메인)
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=

# (선택) canonical · OG 주소 (기본 https://ondoor.co.kr), 알림 메일의 관리자 링크 주소
NEXT_PUBLIC_SITE_URL=
ADMIN_URL=
